<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      NOT retargeted to net10.0. Two independent blockers, either of which alone would stop
      this today (see this task's test_report artifact for exact errors observed):
        1. NuGetGallery.Services'/.Core's netstandard2.1 legs (the only leg a net10.0 project
           can reference) explicitly <Compile Remove> the Authentication/Security/
           PackageManagement/UserManagement/etc. folders this suite exercises, and neither
           project has a net10.0 TargetFramework yet.
        2. This suite's ~293 test files exercise Controllers/Views/App_Start composition/OData/
           Admin surfaces of the *legacy* System.Web/MVC5 web app, almost none of which exist in
           the net10.0 NuGetGallery.csproj (a placeholder shell with only a minimal
           hosting/DI/OData-v1v2/partial-Admin surface ported so far).
      Because NuGetGallery.csproj now targets net10.0 only (no net472 leg remains), this
      project's ProjectReference to it fails to even restore (NU1201), regardless of the above.
    -->
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>NuGetGallery</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\NuGetGallery\Views\Packages\_ValidationIssue.cshtml">
      <Link>Views\Packages\_ValidationIssue.cshtml</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="TestData\certificate.cer" />
    <EmbeddedResource Include="TestData\icon.png" />
    <EmbeddedResource Include="TestData\icon.jpg" />
    <EmbeddedResource Include="TestData\PackageWithDoubleBackwardSlash.1.0.0.nupkg" />
    <EmbeddedResource Include="TestData\PackageWithDoubleForwardSlash.1.0.0.nupkg" />
    <EmbeddedResource Include="TestData\PackageWithVeryLongZipFileEntry.1.0.0.nupkg" />
    <EmbeddedResource Include="TestData\Zip64Package.Corrupted.1.0.0.nupkg" />
    <EmbeddedResource Include="TestData\PackageWithInvalidUnicodeCharacters.1.0.0.nupkg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NuGetGallery\NuGetGallery.csproj" />
    <ProjectReference Include="..\NuGetGallery.Core.Facts\NuGetGallery.Core.Facts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>