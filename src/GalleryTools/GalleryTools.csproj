<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Retargeted from net472 to net10.0 to follow NuGetGallery.csproj, which the scaffold step
      converted from the legacy non-SDK v4.7.2 web app to an SDK-style net10.0-only project (no
      net472 leg remains -- a net472 GalleryTools cannot restore against it at all: NU1201).

      This project does NOT currently build on net10.0. Its Commands/* reference business-logic
      types (NuGetGallery.Authentication.*, NuGetGallery.Infrastructure.Authentication.*,
      NuGetGallery.Security.*, IPackageService, IUserService, ICredentialBuilder, etc.) that live
      in NuGetGallery.Services/NuGetGallery.Core, but only exist on those projects' net472 leg.
      Their netstandard2.1 legs (the only leg a net10.0 project can reference) explicitly
      <Compile Remove> the AccountManagement/Authentication/PackageManagement/Security/
      UserManagement/etc. folders GalleryTools depends on (see NuGetGallery.Services.csproj), and
      neither project has a net10.0 TargetFramework yet. Getting GalleryTools onto net10.0 for
      real requires that work to land first (tracked by the separate "Shared class libraries:
      add/verify net10 target" stage), plus un-excluding (or netstandard2.1-porting) the specific
      folders GalleryTools' commands touch. See this task's test_report artifact for the exact
      build errors observed.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <Description>Tools for performing manual one-time/maintenance operations on the Gallery</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GitHubVulnerabilities2Db\GitHubVulnerabilities2Db.csproj" />
    <ProjectReference Include="..\NuGetGallery\NuGetGallery.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Knapcode.MiniZip" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.Extensions.CommandLineUtils" />
  </ItemGroup>
</Project>