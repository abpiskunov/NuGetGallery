<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Retargeted from net472 to net10.0 to follow NuGetGallery.csproj, which the scaffold step
      converted from the legacy non-SDK v4.7.2 web app to an SDK-style net10.0-only project
      (no net472 leg remains; a net472 GalleryTools cannot restore against it at all: NU1201).
      See this task's test_report artifact for the exact remaining build errors and why they are
      not fixable within this task's boundary today.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <Description>Tools for performing manual one-time/maintenance operations on the Gallery</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GitHubVulnerabilities2Db\GitHubVulnerabilities2Db.csproj" />
    <ProjectReference Include="..\NuGetGallery\NuGetGallery.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Knapcode.MiniZip" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.Extensions.CommandLineUtils" />
  </ItemGroup>
</Project>