<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NuGetGallery</RootNamespace>
    <AssemblyName>NuGetGallery</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- WARNING: This constant disables Admin API token validation for functional testing.
         It must NEVER be set in release or deployment builds. -->
    <DefineConstants Condition="'$(UnsafeAdminApiAuthBypassForTesting)' == 'true'">$(DefineConstants);UNSAFE_ADMIN_API_AUTH_BYPASS_FOR_TESTING</DefineConstants>

    <!--
      This project is mid-migration from the legacy non-SDK System.Web/MVC5/OWIN app
      (TargetFrameworkVersion=v4.7.2) to an SDK-style ASP.NET Core app on net10.0.
      Only the new hosting shell (Program.cs) is wired up so far, with
      Autofac.Extensions.DependencyInjection as the sole DI integration, replacing the
      legacy Autofac.Mvc5/.Owin/.WebApi2 packages built on classic Katana OWIN.

      The rest of the legacy tree below (Controllers, App_Start, OData, Areas\Admin\DynamicData,
      Views, Web.config, etc.) still reflects the old System.Web/MVC5/WebApi2/Dynamic Data APIs,
      none of which exist on ASP.NET Core, and has NOT been ported yet. It is intentionally
      excluded from compilation and from the SDK's default item globbing below so that this
      project builds as a placeholder shell; the legacy files remain in the tree for reference
      and are expected to be replaced/ported incrementally by the follow-on feature-port steps
      (Web.config/middleware port, package replacements, OData v1/v2 feed reimplementation,
      Dynamic Data admin UI rebuild) identified in the parent work item's plan.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
