<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NuGetGallery</RootNamespace>
    <AssemblyName>NuGetGallery</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- WARNING: This constant disables Admin API token validation for functional testing.
         It must NEVER be set in release or deployment builds. -->
    <DefineConstants Condition="'$(UnsafeAdminApiAuthBypassForTesting)' == 'true'">$(DefineConstants);UNSAFE_ADMIN_API_AUTH_BYPASS_FOR_TESTING</DefineConstants>

    <!--
      This project is mid-migration from the legacy non-SDK System.Web/MVC5/OWIN app
      (TargetFrameworkVersion=v4.7.2) to an SDK-style ASP.NET Core app on net10.0.
      Only the new hosting shell (Program.cs) is wired up so far, with
      Autofac.Extensions.DependencyInjection as the sole DI integration, replacing the
      legacy Autofac.Mvc5/.Owin/.WebApi2 packages built on classic Katana OWIN.

      The rest of the legacy tree below (Controllers, App_Start, OData, Areas\Admin\DynamicData,
      Views, Web.config, etc.) still reflects the old System.Web/MVC5/WebApi2/Dynamic Data APIs,
      none of which exist on ASP.NET Core, and has NOT been ported yet. It is intentionally
      excluded from compilation and from the SDK's default item globbing below so that this
      project builds as a placeholder shell; the legacy files remain in the tree for reference
      and are expected to be replaced/ported incrementally by the follow-on feature-port steps
      (Web.config/middleware port, package replacements, OData v1/v2 feed reimplementation,
      Dynamic Data admin UI rebuild) identified in the parent work item's plan.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Configuration\CrossCuttingOptions.cs" />
    <Compile Include="Cookies\ICookieComplianceService.cs" />
    <Compile Include="Middleware\CookieComplianceMiddleware.cs" />
    <Compile Include="AsyncFileUpload\AsyncFileUploadProgress.cs" />
    <Compile Include="AsyncFileUpload\IUploadProgressCacheService.cs" />
    <Compile Include="AsyncFileUpload\MemoryUploadProgressCacheService.cs" />
    <Compile Include="AsyncFileUpload\UploadTracingKeyHelper.cs" />
    <Compile Include="AsyncFileUpload\RegexEx.cs" />
    <Compile Include="AsyncFileUpload\AsyncFileUploadRequestParser.cs" />
    <Compile Include="AsyncFileUpload\AsyncFileUploadProgressMiddleware.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />

    <!--
      Bespoke net10 reimplementation of the legacy OData v1/v2 package feeds. Hand-rolled
      (not built on Microsoft.AspNetCore.OData) because this work item's spike (parent step 0,
      decision D3) found that library cannot serve the legacy v1/v2 atom+xml wire format at
      all. See OData.Core\README.md for what is and is not covered.
    -->
    <Compile Include="OData.Core\V1FeedPackage.cs" />
    <Compile Include="OData.Core\V2FeedPackage.cs" />
    <Compile Include="OData.Core\IPackageFeedSource.cs" />
    <Compile Include="OData.Core\ODataAtomFeedWriter.cs" />
    <Compile Include="OData.Core\ODataMetadataDocument.cs" />
    <Compile Include="Controllers.Core\ODataV1FeedController.cs" />
    <Compile Include="Controllers.Core\ODataV2FeedController.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" />
  </ItemGroup>

</Project>
