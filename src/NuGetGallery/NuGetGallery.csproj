<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NuGetGallery</RootNamespace>
    <AssemblyName>NuGetGallery</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- WARNING: This constant disables Admin API token validation for functional testing.
         It must NEVER be set in release or deployment builds. -->
    <DefineConstants Condition="'$(UnsafeAdminApiAuthBypassForTesting)' == 'true'">$(DefineConstants);UNSAFE_ADMIN_API_AUTH_BYPASS_FOR_TESTING</DefineConstants>

    <!--
      This project is mid-migration from the legacy non-SDK System.Web/MVC5/OWIN app
      (TargetFrameworkVersion=v4.7.2) to an SDK-style ASP.NET Core app on net10.0.
      Only the new hosting shell (Program.cs) is wired up so far, with
      Autofac.Extensions.DependencyInjection as the sole DI integration, replacing the
      legacy Autofac.Mvc5/.Owin/.WebApi2 packages built on classic Katana OWIN.

      The rest of the legacy tree below (Controllers, App_Start, OData, Areas\Admin\DynamicData,
      Views, Web.config, etc.) still reflects the old System.Web/MVC5/WebApi2/Dynamic Data APIs,
      none of which exist on ASP.NET Core, and has NOT been ported yet. It is intentionally
      excluded from compilation and from the SDK's default item globbing below so that this
      project builds as a placeholder shell; the legacy files remain in the tree for reference
      and are expected to be replaced/ported incrementally by the follow-on feature-port steps
      (Web.config/middleware port, package replacements, OData v1/v2 feed reimplementation,
      Dynamic Data admin UI rebuild) identified in the parent work item's plan.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Areas\Admin\Controllers\AdminControllerBase.cs" />
    <Compile Include="Areas\Admin\Controllers\HomeController.cs" />
    <Compile Include="Areas\Admin\ViewModels\HomeViewModel.cs" />
    <!--
      SiteAdminsController.cs has been rewritten for ASP.NET Core (compiles fine on its own
      syntax) but is deliberately NOT included in this build: it depends on IUserService, and
      NuGetGallery.Services/UserManagement/*.cs is entirely excluded from that project's
      netstandard2.1 leg (see NuGetGallery.Services.csproj's netstandard2.1 Compile-Remove
      list), which is the only leg a net10.0 app can reference today (no net10.0 TargetFramework
      exists on NuGetGallery.Services yet - that is the sibling "Shared class libraries:
      add/verify net10 target" stage, still in progress). Re-add this Compile/Content pair once
      that stage adds net10.0 (or at least un-excludes UserManagement from netstandard2.1).
      Compile Include="Areas\Admin\Controllers\SiteAdminsController.cs"
      Compile Include="Areas\Admin\ViewModels\SiteAdminsViewModel.cs"
    -->
  </ItemGroup>

  <ItemGroup>
    <!--
      Razor views for the (partially) rebuilt Areas/Admin surface. Only the views for the
      controllers actually ported above are included; the rest of Areas/Admin/Views/** remains
      on disk (legacy MVC5 Razor, System.Web.Mvc HtmlHelpers) but is not built.
    -->
    <Content Include="Areas\Admin\Views\_ViewImports.cshtml" />
    <Content Include="Areas\Admin\Views\_ViewStart.cshtml" />
    <Content Include="Areas\Admin\Views\Shared\_AdminLayout.cshtml" />
    <Content Include="Areas\Admin\Views\Home\Index.cshtml" />
    <!-- SiteAdmins/Index.cshtml is not included for the same reason SiteAdminsController.cs
         above is excluded: its controller can't compile against net10 yet. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!--
      NuGetGallery.Core and NuGetGallery.Services do not have a net10.0 TargetFramework yet
      (tracked separately by the "Shared class libraries: add/verify net10 target" stage), but
      both build cleanly for their netstandard2.1 leg, which this net10.0 app can reference
      directly. Kept as forward-looking infrastructure for future Admin controllers whose
      dependencies do live in that leg; note that IUserService/IPackageService and most other
      substantive business services currently do NOT (see the comment above).
    -->
    <ProjectReference Include="..\NuGetGallery.Core\NuGetGallery.Core.csproj" />
    <ProjectReference Include="..\NuGetGallery.Services\NuGetGallery.Services.csproj" />
  </ItemGroup>

</Project>
