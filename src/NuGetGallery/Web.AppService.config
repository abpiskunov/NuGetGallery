<?xml version="1.0"?>

<!--
  Optional transform for Azure App Service (Windows). Not tied to a build configuration; apply it
  to the published Web.config (e.g. msdeploy / TransformXml with Web.Release.config applied first).
  No secrets belong here: secrets and real connection strings are App Service app settings /
  connection strings (or Key Vault references), which override Web.config values at runtime.
  See docs/AppServiceSettings.md.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="Gallery.StorageType" value="AzureStorage" xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)"/>
    <add key="Gallery.WarningBanner" value="" xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)"/>
    <add key="Gallery.RequireSSL" value="true" xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)"/>
  </appSettings>
  <connectionStrings>
    <!-- Fail fast if App Service connection strings are not configured, instead of falling back to LocalDB. -->
    <add name="Gallery.SqlServer" connectionString="SET-IN-APP-SERVICE" xdt:Transform="SetAttributes(connectionString)" xdt:Locator="Match(name)"/>
    <add name="Gallery.SupportRequestSqlServer" connectionString="SET-IN-APP-SERVICE" xdt:Transform="SetAttributes(connectionString)" xdt:Locator="Match(name)"/>
    <add name="Gallery.ValidationSqlServer" connectionString="SET-IN-APP-SERVICE" xdt:Transform="SetAttributes(connectionString)" xdt:Locator="Match(name)"/>
  </connectionStrings>
</configuration>
