@model HomeViewModel
@{
    ViewBag.Title = "Site Administration";
}

<section role="main" class="container main-container page-admin-index">
    <h1>Site Administration</h1>
    <p>
        This is a deliberately narrowed rebuild of the legacy Areas/Admin/DynamicData +
        hand-built Admin MVC surface on ASP.NET Core (net10.0). See this work item's D2 spike
        decision: the generic Dynamic Data database browser is dropped (it was disabled by
        default and 100% stock scaffolding); the hand-built controllers below are being ported
        incrementally, one at a time.
    </p>
    <ul>
        <li>
            Site admins &mdash; controller/view written (Areas/Admin/Controllers/SiteAdminsController.cs)
            but not yet compiled/enabled: it needs IUserService, which is unavailable outside the
            net472 leg of NuGetGallery.Services until that library adds a net10.0 target.
        </li>
        <li>Change username &mdash; not yet ported.</li>
        <li>Lock/unlock packages &mdash; not yet ported.</li>
        <li>Lock/unlock users &mdash; not yet ported.</li>
        <li>Package ownership &mdash; not yet ported.</li>
        <li>Package sponsorship &mdash; not yet ported.</li>
        <li>Popularity transfers &mdash; not yet ported.</li>
        <li>Reserved namespaces &mdash; not yet ported.</li>
        <li>Revalidation &mdash; not yet ported.</li>
        <li>Security policies &mdash; not yet ported.</li>
        <li>Support requests &mdash; not yet ported.</li>
        <li>Update listed &mdash; not yet ported.</li>
        <li>Validation &mdash; not yet ported.</li>
        <li>Federated credentials &mdash; not yet ported.</li>
        <li>API keys &mdash; not yet ported.</li>
        <li>Delete / delete account &mdash; not yet ported.</li>
        <li>Features &mdash; not yet ported.</li>
        @if (Model.ShowLuceneAdmin)
        {
            <li>Lucene admin &mdash; not yet ported.</li>
        }
        @if (Model.ShowValidation)
        {
            <li>Async validation admin &mdash; not yet ported.</li>
        }
    </ul>
</section>
