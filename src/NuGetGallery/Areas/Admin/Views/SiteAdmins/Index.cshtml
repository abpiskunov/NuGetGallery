@model SiteAdminsViewModel
@{
    ViewBag.Title = "Site Admins";
}

<section role="main" class="container main-container">
    <h2>Current Admins</h2>
    <table aria-label="Current Admins">
        @foreach (var adminUsername in Model.AdminUsernames)
        {
            <tr>
                <td>@adminUsername</td>
                <td>
                    <form asp-area="Admin" asp-controller="SiteAdmins" asp-action="RemoveAdmin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="username" value="@adminUsername" />
                        <button type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </table>

    <h2>Add Admin</h2>
    <form asp-area="Admin" asp-controller="SiteAdmins" asp-action="AddAdmin" method="post">
        @Html.AntiForgeryToken()
        <input type="text" name="username" />
        <button type="submit">Add</button>
    </form>
</section>
